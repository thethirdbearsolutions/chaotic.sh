<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notifications (CHT-1612); asked for after sign-in, with a reason. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChaoticApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chaotic">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What a notification opens (CHT-1660): MainActivity under a name only this
             app can start, so MainActivity trusts the entry id that comes with it. -->
        <activity-alias
            android:name=".NotificationTapActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- The sign-in redirect (CHT-1649): AppAuth's receiver, declared again so it
             answers only the verified App Links URL. tools:node="replace" drops AppAuth's
             own filter on a custom scheme, which any app could also claim. Host and path
             come from oauthRedirectUri in build.gradle.kts; chaotic.sh's
             /.well-known/assetlinks.json verifies them for the release key. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${oauthRedirectHost}" />
                <data android:path="${oauthRedirectPath}" />
            </intent-filter>
        </activity>

        <!-- UnifiedPush events, forwarded by the connector library's own receiver (CHT-1612). -->
        <service
            android:name=".push.ChaoticPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Approve and Reject on gate and review notifications (CHT-1665); only this app's own PendingIntents reach it. -->
        <receiver
            android:name=".push.DecisionReceiver"
            android:exported="false" />
    </application>

</manifest>
